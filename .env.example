# Copy to .env and fill in. Only NEXT_PUBLIC_* variables reach the browser.

# App
APP_URL=http://localhost:3000
# How many proxies you run in front of the app (Vercel, nginx, a load balancer = 1). Rate limits and
# the audit log read the client IP that far from the end of X-Forwarded-For, so clients can't fake it.
# Use 0 if the app is reachable directly with no proxy.
TRUST_PROXY_HOPS=1

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/movenowfl?schema=public

# Auth — AUTH_SECRET must be a random string of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_SESSION_MAX_AGE_DAYS=30

# Seed — sign-in password for the demo accounts created by `npm run db:seed`
# (john.doe@movenow.test and admin@movenow.test). Local development only.
SEED_DEMO_PASSWORD=movenow-demo-123

# Email (SMTP). Without SMTP_HOST, development prints emails (codes) to the server console instead.
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords),
# and use your Gmail address as SMTP_USER. Gmail sends about 500 emails a day at most.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="MoveNowFL <you@gmail.com>"

# Not used yet (later phases: uploads, payments, SMS, real-time)
# File storage: folder for uploaded photos (local disk driver). Default ./storage
# STORAGE_DIR=./storage
# For a bucket driver later:
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
